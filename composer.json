{
    "name": "ohtuser/query-spy",
    "homepage": "https://github.com/ohtuser/query-spy",
    "description": "QuerySpy: Real-time Laravel query performance monitoring — N+1 detection, slow queries, duplicate queries, memory tracking, and a beautiful developer dashboard.",
    "type": "library",
    "keywords": ["laravel", "query", "performance", "debugging", "monitoring", "slow-query"],
    "license": "MIT",
    "authors": [
        {
            "name": "QuerySpy",
            "email": "hello@queryspy.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "QuerySpy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuerySpy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":      "vendor/bin/phpunit",
        "test:unit": "vendor/bin/phpunit --testsuite=Unit",
        "test:feat": "vendor/bin/phpunit --testsuite=Feature"
    },
    "extra": {
        "laravel": {
            "providers": [
                "QuerySpy\\QuerySpyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
